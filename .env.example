# Copy to .env and fill in. .env is git-ignored; never commit real values.

DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
# DATABRICKS_TRANSACTIONS_TABLE=aml_copilot.transactions
# TRANSACTION_ROW_LIMIT=10000

SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=

# Supabase Postgres connection string (Project Settings > Database)
SUPABASE_DB_URL=

# Which model family answers: gemini (Google Gemini on Vertex AI - the deployed setup), anthropic or vertex (Claude).
LLM_PROVIDER=gemini
GCP_PROJECT=
# adc = your gcloud login / Application Default Credentials; token = GCP_ACCESS_TOKEN (gcloud auth print-access-token);
# databricks = keyless federation used by the Databricks jobs (needs the two settings below).
GCP_AUTH=adc
# GCP_ACCESS_TOKEN=
# GCP_WIF_AUDIENCE=//iam.googleapis.com/projects/<number>/locations/global/workloadIdentityPools/databricks/providers/databricks
# GCP_SERVICE_ACCOUNT=aml-gemini@<project>.iam.gserviceaccount.com
# The summarizer's model (a fast Flash model); the typology judge, narrative writer and fact-checker use a Pro model.
# LLM_MODEL=gemini-3.5-flash
# TYPOLOGY_MODEL=gemini-3.1-pro-preview
# NARRATIVE_MODEL=gemini-3.1-pro-preview
# FAITHFULNESS_MODEL=gemini-3.1-pro-preview
# Only if LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=
