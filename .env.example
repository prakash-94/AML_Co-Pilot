# Copy to .env and fill in. .env is git-ignored; never commit real values.

DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
# DATABRICKS_TRANSACTIONS_TABLE=aml_copilot.transactions
# TRANSACTION_ROW_LIMIT=10000

SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=

# Supabase Postgres connection string (Project Settings > Database)
SUPABASE_DB_URL=

# console.anthropic.com > API Keys > Create Key (used by the Evidence Agent's summarizer)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# Optional: a different model for the typology judge only (blank = use ANTHROPIC_MODEL)
# TYPOLOGY_MODEL=
# Optional: a different model for the narrative writer only (blank = use ANTHROPIC_MODEL)
# NARRATIVE_MODEL=
# Optional: a different model for the faithfulness judge only (blank = use ANTHROPIC_MODEL)
# FAITHFULNESS_MODEL=
